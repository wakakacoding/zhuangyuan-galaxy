---
import BaseLayout from '../layouts/BaseLayout.astro';
import AggregateSankey from '../components/viz/AggregateSankey';
import InsightChart, { type ChartRow } from '../components/viz/InsightChart';
import SouthwardMini from '../components/viz/SouthwardMini.astro';
import GuidePopover from '../components/shell/GuidePopover';
import ShareButton from '../components/shell/ShareButton';
import { readFileSync } from 'node:fs';

const stats = JSON.parse(
  readFileSync(new URL('../../public/data/stats.json', import.meta.url), 'utf8'),
);
const dynasties = JSON.parse(
  readFileSync(new URL('../../public/data/dynasties.json', import.meta.url), 'utf8'),
) as { key: string; name: string; color: string; order: number }[];
dynasties.sort((a, b) => a.order - b.order);
const maxDyn = Math.max(...Object.values<number>(stats.by_dynasty));
const maxSurname = stats.top_surnames[0][1];
const dynName = (k: string) => dynasties.find((d) => d.key === k)?.name ?? k;

// 年龄直方图行（金色）
const ageRows: ChartRow[] = stats.age_histogram.buckets.map(
  (b: { label: string; count: number }) => ({ label: b.label, value: b.count }),
);
// 分朝平均年龄折线行（无样本朝代断开）
const ageDynRows: ChartRow[] = stats.avg_age_by_dynasty.map(
  (d: { dynasty: string; avg_age: number | null; n: number }) => ({
    label: dynName(d.dynasty),
    value: d.avg_age,
    hint: d.n ? `n=${d.n}` : '无样本',
  }),
);
// 完整度直方图行：bucket 越高越金——低分段暗淡即「淡星」本色
const compRows: ChartRow[] = stats.completeness_histogram.map(
  (b: { bucket: number; label: string; count: number }) => ({
    label: b.label,
    value: b.count,
    color: `rgba(201,162,39,${(0.18 + b.bucket * 0.82).toFixed(2)})`,
  }),
);
const compN: number = stats.total;
const readings = JSON.parse(
  readFileSync(new URL('../../public/data/readings.json', import.meta.url), 'utf8'),
) as { person_id: string; title: string; summary: string }[];
const index = JSON.parse(
  readFileSync(new URL('../../public/data/person-index.json', import.meta.url), 'utf8'),
) as { id: string; name: string; dynasty: string; exam_year: number }[];
const personById = new Map(index.map((p) => [p.id, p]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="数据问答">
  <main class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold text-jin">数据问答</h1>
    <p class="mt-1 text-sm text-miDim">
      先读几段有出处的人生，再看时代的统计。统计基于当前已收录 {stats.total} 人，随本站整理持续更新；
      各卡恒定标注样本量 n。缺的是本站尚未录入的字段，不据此推断史料不存在。
    </p>

    <section id="lives" class="mt-8 scroll-mt-16">
      <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">金榜题名之后，他们经历了什么？</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        {readings.map((r) => {
          const person = personById.get(r.person_id);
          return (
            <a href={`${base}/person/${r.person_id}/`} class="block rounded-lg border border-jin/25 bg-dai/50 p-4 hover:border-jin">
              <p class="font-serif text-base font-bold text-mi">{person?.name ?? r.title}</p>
              <p class="mt-1 font-serif text-xs text-miDim">{person ? `${dynName(person.dynasty)} · ${person.exam_year} 年` : ''}</p>
              <p class="mt-2 font-serif text-sm leading-6 text-mi/90">{r.summary}</p>
            </a>
          );
        })}
      </div>
    </section>

    <h2 class="mt-12 font-serif text-base font-bold text-miDim">时代的统计</h2>

    {/* q0 总览：朝代分布 */}
    <section id="q0" class="mt-8 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">哪个朝代状元最多？</h2>
        <ShareButton client:load anchor="q0" />
      </div>
      <div class="space-y-1.5">
        {dynasties.map((d) => (
          <div class="flex items-center gap-3 text-sm">
            <span class="w-16 shrink-0 text-right text-miDim">{d.name}</span>
            <div class="h-4 rounded-sm" style={`width:${(stats.by_dynasty[d.key] / maxDyn) * 100}%;background:${d.color}`} />
            <span class="text-mi">{stats.by_dynasty[d.key]}</span>
          </div>
        ))}
      </div>
    </section>

    {/* q1 最年轻 + 年龄直方图 */}
    <section id="q1" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">最年轻的状元是谁？</h2>
        <GuidePopover client:load inline title="年龄直方图怎么读">
          横轴为夺魁年龄（5 岁分桶），纵轴为人数。峰值在 30 岁上下——金榜题名多是中年事。
          仅 {stats.age_histogram.n} 人有生年可考（占 {Math.round((stats.age_histogram.n / stats.total) * 100)}%），分布偏向文献丰盈的朝代与名人。
        </GuidePopover>
        <ShareButton client:load anchor="q1" />
      </div>
      <InsightChart
        client:visible
        type="histogram"
        rows={ageRows}
        n={stats.age_histogram.n}
        yName=" 人"
        ariaLabel="夺魁年龄分布直方图"
      />
      <p class="mb-2 mt-4 text-xs text-miDim">
        最年轻的十位（平均夺魁年龄 {stats.avg_age} 岁；仅计生年确切、且状元身份无争议者）：
      </p>
      <ol class="space-y-1.5">
        {stats.youngest.map((a: { id: string; name: string; dynasty: string; age: number }, i: number) => (
          <li class="flex items-baseline gap-3 text-sm">
            <span class="w-6 text-right text-jin/70">{i + 1}.</span>
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/person/${a.id}`} class="text-mi underline decoration-jin/40">{a.name}</a>
            <span class="text-miDim">{dynName(a.dynasty)} · {a.age} 岁夺魁</span>
          </li>
        ))}
      </ol>
      {stats.youngest_uncertain?.length > 0 && (
        <div class="mt-3 rounded-md border border-miDim/25 px-3 py-2">
          <p class="mb-1 text-xs text-miDim">
            存疑参考：以下诸人生年系「约」或其状元身份存疑，年龄不宜与其他条目等量齐观，故未计入上方确定榜。
          </p>
          <p class="text-xs leading-relaxed text-miDim">
            {stats.youngest_uncertain
              .map((a: { name: string; dynasty: string; age: number }) => `${a.name}（${dynName(a.dynasty)}·${a.age} 岁）`)
              .join('、')}
          </p>
        </div>
      )}
    </section>

    {/* q2 分朝平均年龄 */}
    <section id="q2" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">平均夺魁年龄历代如何变化？</h2>
        <GuidePopover client:load inline title="分朝折线怎么读">
          各朝平均夺魁年龄总体走高：唐约 30 岁，清已逾 34 岁——殿试层级叠加、应试周期拉长，夺魁越来越是「资深考生」的游戏。无足够生年样本的朝代如实断开，不虚接。
        </GuidePopover>
        <ShareButton client:load anchor="q2" />
      </div>
      <InsightChart
        client:visible
        type="line"
        rows={ageDynRows}
        yName=" 岁"
        ariaLabel="各朝代平均夺魁年龄折线图"
      />
    </section>

    {/* q3 姓氏 */}
    <section id="q3" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">哪个姓氏出状元最多？</h2>
        <ShareButton client:load anchor="q3" />
      </div>
      <p class="mb-2 text-xs text-miDim">
        口径：姓氏经繁简归一后统计（如「張」并入「张」），复姓（独孤 / 鲜于 / 徒单）整体计作一姓。
      </p>
      <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2 sm:gap-x-8">
        {stats.top_surnames.slice(0, 10).map(([s, n]: [string, number]) => (
          <div class="flex items-center gap-3 text-sm">
            <span class="w-10 shrink-0 text-right text-miDim">{s}</span>
            <div class="h-3.5 rounded-sm bg-jin/70" style={`width:${(n / maxSurname) * 70}%`} />
            <span class="text-mi">{n}</span>
          </div>
        ))}
      </div>
    </section>

    {/* q4 南移缩略图 */}
    <section id="q4" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">状元产地如何南移？</h2>
        <GuidePopover client:load inline title="迁移线怎么读">
          每点为某朝全部状元籍贯的地理重心，金色连线按时序贯穿：唐在黄河中下游，北宋移至江淮，明清沉入江浙。背后是经济重心南移与南方书院的兴起。各点标注 n=有坐标者/该朝总数；辽金元样本稀少，结论需谨慎。
        </GuidePopover>
        <ShareButton client:load anchor="q4" />
      </div>
      <SouthwardMini />
    </section>

    {/* q5 三元及第 */}
    <section id="q5" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">哪些人连中三元？</h2>
        <ShareButton client:load anchor="q5" />
      </div>
      <p class="mb-3 text-xs text-miDim">
        乡试解元、会试会元、殿试状元连缀一身，千余年间仅 {stats.sanyuan.length} 人：
      </p>
      <div class="flex flex-wrap gap-2">
        {stats.sanyuan.map((p: { id: string; name: string; dynasty: string; exam_year: number }) => (
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/?p=${p.id}`} class="rounded-full border border-jin/40 px-3 py-1 text-sm text-jin hover:bg-jin/10">
            {p.name} · {dynName(p.dynasty)} · {p.exam_year}
          </a>
        ))}
      </div>
    </section>

    {/* q6 旧锚点保留。分类混有官职、去向和死亡，不作人生流向。 */}
    <section id="q6" class="mt-12 scroll-mt-16">
      <div class="mb-1 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">一份不能当成结局的分类</h2>
        <ShareButton client:load anchor="q6" />
      </div>
      <p class="mb-3 text-sm leading-7 text-miDim">
        这里原来用桑基图，把登科后的官职、后来的去向和死亡放在同一条流向里。宰辅、归隐、殉国、早逝并不是同一类结局，人数也不能相加成人的一生。图先不展开。它不比较人生高低，也不表示谁过得更好。
      </p>
      <div class="mb-4 grid gap-3 sm:grid-cols-3">
        {[
          ['记载中的官职', stats.career_dimensions?.office],
          ['记载中的生活去向', stats.career_dimensions?.path],
          ['记载中的死亡', stats.career_dimensions?.death],
        ].map(([label, rows]) => (
          <div class="rounded-lg border border-miDim/20 p-3">
            <p class="font-serif text-sm font-bold text-mi">{label}</p>
            <p class="mt-1 text-[11px] leading-5 text-miDim">三组各自计数，不能相加，也不表示生活好坏。</p>
            <ul class="mt-2 space-y-1 text-xs text-miDim">
              {(rows as { label: string; count: number }[] | undefined)?.map((row) => (
                <li class="flex justify-between gap-3"><span>{row.label}</span><span>{row.count}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {stats.career_pending > 0 && (
        <p class="mb-3 text-xs leading-6 text-miDim">另有 {stats.career_pending} 条旧记录拆不准，保持待核，没有填进上面任何一组。</p>
      )}

      <details class="rounded-lg border border-miDim/20 bg-dai/30 p-4">
        <summary class="cursor-pointer font-serif text-sm text-miDim">仍要查看这张旧图</summary>
        <p class="mt-3 text-xs leading-6 text-miDim">
          样本只来自本站已填了这些分类的人。带宽是分类计数，不是人生阶段的流转。未知没有被填进任何一类。
        </p>
        <div class="mt-3">
          <AggregateSankey client:only="react" />
        </div>
      </details>
    </section>

    {/* q7 诚实的数据：完整度直方图 */}
    <section id="q7" class="mt-12 scroll-mt-16">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="border-l-2 border-jin pl-2 text-lg font-bold">本站档案整理到哪一步？</h2>
        <GuidePopover client:load inline title="完整度直方图怎么读">
          横轴是本站档案完整度（0–1，由已录入的基础字段、事件数、关系数和有无简介加权），纵轴为人数。它只衡量本站整理进度，不衡量存世史料总量，也不代表人物价值或记载是否可信。集中在左端，表示多数档案还只录入了姓名和科年。空白字段保持空白，本站不编造。
        </GuidePopover>
        <ShareButton client:load anchor="q7" />
      </div>
      <InsightChart
        client:visible
        type="histogram"
        rows={compRows}
        n={compN}
        yName=" 人"
        ariaLabel="本站档案完整度分布直方图"
      />
      <div class="mt-4 rounded-lg border border-miDim/20 bg-dai/40 p-4">
        <p class="text-sm leading-7 text-miDim">
          这 {stats.total} 位状元中，许多人在本站目前只录入了姓名与科年。
          当前籍贯坐标覆盖率 {(stats.geo_coverage * 100).toFixed(0)}%，其余正随考证工作流逐步回填。
          未录入不等于史料不存在。本站不编造字段，空白处保持待整理。
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
