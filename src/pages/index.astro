---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarMapGate from '../components/viz/StarMapGate';
import StarMapList from '../components/viz/StarMapList';
import FilterBar from '../components/shell/FilterBar';
import PersonOverlay from '../components/person/PersonOverlay';
import { readFileSync } from 'node:fs';

const stats = JSON.parse(
  readFileSync(new URL('../../public/data/stats.json', import.meta.url), 'utf8'),
);
const index = JSON.parse(
  readFileSync(new URL('../../public/data/person-index.json', import.meta.url), 'utf8'),
) as { id: string; name: string; dynasty: string; exam_year: number }[];
const dynasties = JSON.parse(
  readFileSync(new URL('../../public/data/dynasties.json', import.meta.url), 'utf8'),
) as { key: string; name: string }[];
const readings = JSON.parse(
  readFileSync(new URL('../../public/data/readings.json', import.meta.url), 'utf8'),
) as { id: string; person_id: string; title: string; summary: string }[];
const personById = new Map(index.map((p) => [p.id, p]));
const dynastyName = new Map(dynasties.map((d) => [d.key, d.name]));
const cards = readings.map((r) => {
  const person = personById.get(r.person_id);
  return {
    ...r,
    name: person?.name ?? r.person_id,
    year: person?.exam_year,
    dynasty: dynastyName.get(person?.dynasty ?? '') ?? '',
  };
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="星图">
  <section class="mx-auto max-w-3xl px-4 pb-6 pt-8">
    <h1 class="font-serif text-2xl font-bold leading-snug text-jin sm:text-3xl">金榜题名之后，人生才刚刚展开。</h1>
    <p class="mt-3 max-w-2xl font-serif text-sm leading-7 text-miDim">
      我因一段视频，开始好奇那些状元后来的人生。一次夺魁，不能概括一个人的一生。我想在这里，沿着有据可查的经历，慢慢看见荣耀之后，各不相同的日子。
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="#readings" class="inline-flex min-h-11 items-center rounded-full border border-jin bg-jin/15 px-4 font-serif text-sm font-bold text-jin">读一段人生</a>
      <a href="#starmap" data-enter-map="1" class="inline-flex min-h-11 items-center rounded-full border border-miDim/40 px-4 font-serif text-sm text-mi">走进星河</a>
    </div>
  </section>

  <section id="readings" class="mx-auto max-w-3xl scroll-mt-16 px-4 pb-8">
    <h2 class="font-serif text-base font-bold text-mi">三段有出处的人生</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      {cards.map((card) => (
        <a href={`${base}/person/${card.person_id}/`} class="block rounded-lg border border-jin/25 bg-dai/50 p-4 hover:border-jin">
          <p class="font-serif text-base font-bold text-mi">{card.name}</p>
          <p class="mt-1 font-serif text-xs text-miDim">{card.dynasty}{card.year ? ` · ${card.year} 年` : ''}</p>
          <p class="mt-2 font-serif text-sm leading-6 text-mi/90">{card.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="starmap" class="scroll-mt-12">
    <FilterBar client:load />
    <div class="relative h-[calc(100vh-6rem)] min-h-[32rem]">
      <StarMapGate client:only="react" />
      <div class="pointer-events-none absolute bottom-4 left-4 z-10 hidden max-w-xs rounded-lg border border-jin/20 bg-xuan/85 p-4 backdrop-blur md:block">
        <p class="text-xs leading-6 text-miDim">
          每一颗星是一位有姓名可考的状元，共 {stats.total} 位。
          横轴是夺魁之年，纵带是朝代。星的基础明暗只反映本站档案整理到哪一步，不代表人物价值，也不代表存世史料多少或记载是否可信。
        </p>
        <p class="mt-2 text-[11px] text-miDim/60">
          当前已整理深档案 {stats.profiles} 人，数据更新于 {stats.build_date}
        </p>
      </div>
    </div>
    <div class="mx-auto max-w-6xl px-4 py-4">
      <details open class="rounded-lg border border-jin/20 bg-dai/30 p-3">
        <summary class="cursor-pointer font-serif text-sm text-jin">键盘名单（与星图同一批人，可不用鼠标浏览）</summary>
        <div class="mt-3">
          <StarMapList client:idle />
        </div>
      </details>
    </div>
  </section>
  <PersonOverlay client:load />
</BaseLayout>

<script>
  import { initUrlSync } from '../store/filters';
  import { initSelectionFromUrl } from '../store/selection';
  initUrlSync();
  initSelectionFromUrl();

  const map = document.getElementById('starmap');
  const params = new URLSearchParams(window.location.search);
  const hasDeepLink = ['dyn', 'q', 'p'].some((key) => params.get(key));
  if (hasDeepLink) map?.scrollIntoView();
  document.querySelector('[data-enter-map]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('starmap:enter'));
  });
</script>
